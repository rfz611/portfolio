# De onde o site busca as músicas (.ogg e .mp3).
# Desenvolvimento: a pasta public/audio (fora do Git).
# Produção (Vercel): o endereço público do bucket Cloudflare R2.
VITE_AUDIO_BASE_URL=/audio

# De onde o site busca o modelo do carro (car.glb, fora do Git pela licença).
# Desenvolvimento: deixe vazio (usa public/models/car.glb).
# Produção: o endereço público do arquivo no mesmo bucket das músicas.
VITE_CAR_MODEL_URL=
